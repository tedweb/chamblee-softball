---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

import { seasonRecords } from '../../data/season';
import gamechanger from '../../../docs/data.json';

interface GameChangerTeam { name: string; roster?: string[]; coaches?: Record<string, string>; }
export function getStaticPaths() {
  // getStaticPaths runs in its own scope and can only use imports, so the lookup lives here.
  const gcTeams = gamechanger.teams as Record<string, GameChangerTeam>;
  return [
    { slug: 'varsity', key: 'varsity', image: 'HPC_IMG_2256.JPG', blurb: 'Experienced. Composed. Ready for every inning.' },
    { slug: 'junior-varsity', key: 'jv', image: 'HPC_IMG_2253.JPG', blurb: 'Building confidence, fundamentals, and the next generation of Bulldogs.' },
    { slug: 'middle-school', key: 'ms', image: 'HPC_IMG_2252.JPG', blurb: 'Learning the game, competing together, and growing the Bulldog tradition.' },
  ].map(team => ({ params: { team: team.slug }, props: {
    ...team, ...seasonRecords[team.slug as keyof typeof seasonRecords],
    // Roster and coaches come from the GameChanger export (docs/data.json).
    players: gcTeams[team.key]?.roster ?? [],
    coaches: Object.entries(gcTeams[team.key]?.coaches ?? {}).map(([role, name]) => ({ role, name })),
  }}));
}
const team = Astro.props;
const teamLinks = [["varsity", "Varsity"], ["junior-varsity", "JV"], ["middle-school", "Middle School"]];
---
<Base title={`${team.name} — Chamblee Softball`} bodyClass="production-site">
  <SiteHeader /><main>
    <section class="teams-heading"><p>2026 SEASON</p><h1>Meet the Bulldogs</h1></section>
    <nav class="team-toggle section-wrap" aria-label="Select a team">{teamLinks.map(([slug, label]) => <a href={`/teams/${slug}`} class:list={{active: team.slug === slug}} aria-current={team.slug === slug ? "page" : undefined}>{label}</a>)}</nav>
    <section class="roster-section section-wrap" id="roster">
      <div class="section-heading"><p>{team.name.toUpperCase()} · {team.players.length} PLAYERS</p></div>
      <div class="roster-grid">{team.players.map(player => {
        const [name, number] = player.split(', #');
        return <article><b aria-label={number ? `Jersey number ${number}` : 'Jersey number not listed'}>{number ? `#${number}` : '—'}</b><span>{name}</span></article>;
      })}</div>
    </section>
    <section class="coach-section" id="coaches"><div><p>COACHING STAFF</p><h2>Leading the {team.name} Bulldogs</h2><ul class="coach-list">{team.coaches.map(coach => <li><strong>{coach.name}</strong><span>{coach.role}</span></li>)}</ul><a href="/program">About the program →</a></div></section>
  </main><SiteFooter />
</Base>

<style>
.teams-heading{padding:50px max(24px,calc((100% - 1132px)/2));background:var(--navy);color:#fff}
.teams-heading p{font-size:.875rem;letter-spacing:.15em}
.teams-heading h1{margin:12px 0 0;font:400 clamp(3rem,7vw,6rem)/1 "Archivo Black",Impact,sans-serif;text-transform:uppercase}
.team-toggle{display:flex;flex-wrap:wrap;padding-top:40px}
.team-toggle a{padding:10px 14px;border:1px solid var(--navy);background:transparent;color:var(--navy);font-family:Oswald,Arial,sans-serif;font-size:1rem;font-weight:600;text-decoration:none}
.team-toggle a.active{background:var(--navy);color:#fff}
.team-toggle a:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.roster-section{padding-top:24px}
.roster-grid{margin-top:20px}
.coach-section{display:block}
.coach-section>div{max-width:1180px;margin-inline:auto;padding:40px 24px}
</style>

