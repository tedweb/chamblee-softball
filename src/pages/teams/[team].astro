---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHero from '../../components/PageHero.astro';
import { seasonRecords } from '../../data/season';
import data from '../../data/teams.json';
export function getStaticPaths() {
  return [
    { slug: 'varsity', key: 'varsity', image: 'HPC_IMG_2256.JPG', blurb: 'Experienced. Composed. Ready for every inning.' },
    { slug: 'junior-varsity', key: 'jv', image: 'HPC_IMG_2253.JPG', blurb: 'Building confidence, fundamentals, and the next generation of Bulldogs.' },
    { slug: 'middle-school', key: 'middle', image: 'HPC_IMG_2252.JPG', blurb: 'Learning the game, competing together, and growing the Bulldog tradition.' },
  ].map(team => ({ params: { team: team.slug }, props: {
    ...team, ...seasonRecords[team.slug as keyof typeof seasonRecords],
    players: data.players[team.key as keyof typeof data.players],
    coaches: data.coaches[team.key as keyof typeof data.coaches],
  }}));
}
const team = Astro.props;
---
<Base title={`${team.name} — Chamblee Softball`} bodyClass="production-site">
  <SiteHeader /><main>
    <PageHero eyebrow="CHAMBLEE BULLDOGS" title={team.name} text={team.blurb} image={team.image} />
    <section class="team-summary section-wrap">
      <div><p>OVERALL RECORD</p><strong>{team.overall}</strong><small>{team.key === 'jv' ? 'Wins–losses' : 'Wins–losses–ties'}</small></div>
      {team.region && <div><p>REGION RECORD</p><strong>{team.region}</strong></div>}
      <div><p>TEAM LINKS</p><a href={`/schedule?team=${team.slug}`}>Team schedule →</a><br/><a href="#coaches">Meet the coaches →</a></div>
    </section>
    <section class="roster-section section-wrap" id="roster">
      <div class="section-heading"><p>{team.name.toUpperCase()} · {team.players.length} PLAYERS</p><h2>Meet the Bulldogs</h2></div>
      <div class="roster-grid">{team.players.map(player => {
        const [name, number] = player.split(', #');
        return <article><b aria-label={number ? `Jersey number ${number}` : 'Jersey number not listed'}>{number ? `#${number}` : '—'}</b><span>{name}</span></article>;
      })}</div>
    </section>
    <section class="coach-section" id="coaches"><img src="/images/IMG_6912.jpeg" alt="Chamblee Softball field"/><div><p>COACHING STAFF</p><h2>Leading the Bulldogs</h2><ul class="coach-list">{team.coaches.map(coach => {
      const [name, role] = coach.split(', ');
      return <li><strong>{name}</strong><span>{role === 'HC' ? 'Head Coach' : 'Assistant Coach'}</span></li>;
    })}</ul><a href="/program">About the program →</a></div></section>
  </main><SiteFooter />
</Base>
