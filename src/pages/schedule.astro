<Base title="Schedule — Chamblee Softball" bodyClass="production-site"><SiteHeader /><main><PageHero eyebrow="2026 SEASON" title="Schedule" text="Three teams. One program. Every game in one place." image="IMG_6912.jpeg" /><section class="schedule-section section-wrap"><div class="schedule-tools"><div><button class="active">All teams</button><button>Varsity</button><button>JV</button><button>Middle School</button></div><a href="#">+ Add schedule to calendar</a></div><div class="schedule-list">{games.map((g)=><article><time>{g[0]}</time><span><b>{g[1]}</b><small>{g[3]}</small></span><h2>vs. {g[2]}</h2><strong>{g[4]}</strong><a href="#">Details →</a></article>)}</div><p class="data-note">Sample dates and opponents are shown for layout planning. Confirm the official schedule before launch.</p></section></main><SiteFooter /></Base>
