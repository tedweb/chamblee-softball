---
import { pinkOut } from "../data/articles";
import LastGameCard from "../components/LastGameCard.astro";
import HomeCarousel from "../components/HomeCarousel.astro";
import SponsorCarousel from "../components/SponsorCarousel.astro";
import NextGameCard from "../components/NextGameCard.astro";
import { lastGame } from "../data/last-game";
import Base from "../layouts/Base.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro";
---
<Base title="Chamblee Bulldogs Softball" description="Schedules, teams, news and support for Chamblee High School Softball." bodyClass="production-site"><SiteHeader /><main>
  <section class="home-dugout"><div><p>WELCOME TO THE BLUE AND GOLD</p><h1>Poise in the circle.<br/><em>Power at the plate.</em></h1><span>The official home of Chamblee High School Softball—Varsity, Junior Varsity, Middle School, and the families who back every inning.</span></div><HomeCarousel /></section>
  <section class="primary-home-article notice-card pink-preview" aria-label="Latest article"><p class="article-label">PINK OUT · TUESDAY, OCTOBER 6, 2026 · 5:00 P.M.</p><h2><a href={pinkOut.href}>{pinkOut.title}</a></h2><p>{pinkOut.excerpt}</p><a class="article-read" href={pinkOut.href}>Get the Pink Out details & donation QR code →</a></section>
  <p class="photographer-thanks section-wrap">Special thanks to <strong>Damon Scher</strong> for sharing his photography with the Chamblee softball community. Follow him on Instagram at <a href="https://instagram.com/scher_shotzz?vrfl=MTZ4bGNlMTM0NW1jbg%3D%3D" target="_blank" rel="noopener noreferrer">@scher_shotzz</a>.</p>
  <section class="home-dashboard section-wrap">
    <SponsorCarousel />
    {lastGame && <LastGameCard {...lastGame} />}
    <NextGameCard />
  </section>
  <section class="home-story" id="news"><div><p>FROM THE FIELD</p><h2>Every inning,<br/>together.</h2><span>Chamblee’s start is built on preparation, trust, and a group that refuses to give away an inning.</span><a href="/program">Meet the program →</a></div><img src="/images/IMG_2256.JPG" alt="Chamblee players walking together after a game" /></section></main><SiteFooter /></Base>



<style>
  .photographer-thanks { margin-block: 28px 0; font: 400 .95rem/1.65 "DM Sans", Arial, sans-serif; color: var(--navy); }
  .photographer-thanks a { font-weight: 700; text-underline-offset: 3px; }
</style>
