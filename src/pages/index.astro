---
import { seniorNight } from "../data/articles";
import schedule from "../data/schedule.json";
import teams from "../data/teams.json";
import { seasonRecords } from "../data/season";
import Base from "../layouts/Base.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro";
const nextGame = schedule.games.find(game => new Date(game.start) >= new Date() && game.status !== "CANCELLED");
---
<Base title="Chamblee Bulldogs Softball" description="Schedules, teams, news and support for Chamblee High School Softball." bodyClass="production-site"><SiteHeader /><main>
  <section class="home-dugout"><div><p>WELCOME TO THE BLUE AND GOLD</p><h1>Poise in the circle.<br/><em>Power at the plate.</em></h1><span>The official home of Chamblee High School Softball—Varsity, Junior Varsity, Middle School, and the families who back every inning.</span></div><img src="/images/HPC_IMG_2253.JPG" alt="Chamblee teammates celebrating together" /></section>
  <section class="quick-links"><a href="/schedule"><b>01</b><span>Schedule<small>All three teams</small></span></a><a href="/teams/varsity"><b>02</b><span>Teams<small>Rosters & coaches</small></span></a><a href="https://gc.com/"><b>03</b><span>Live scores<small>GameChanger</small></span></a><a href="/support#donate"><b>04</b><span>Support us<small>Give to the program</small></span></a></section>
  <section class="home-dashboard section-wrap"><article class="result-card"><p>VARSITY COACHING STAFF</p><h2>Meet the coaches</h2>{teams.coaches.varsity.map(coach => <div class="home-coach"><span>{coach.split(", ")[0]}</span><small>{coach.endsWith("HC") ? "Head Coach" : "Assistant Coach"}</small></div>)}<a href="/teams/varsity#coaches">Varsity roster &amp; coaches →</a></article><article class="next-card"><p>NEXT ON THE CALENDAR</p><h2>{nextGame?.title ?? "Follow the Bulldogs"}</h2><span>{nextGame ? new Date(nextGame.start).toLocaleString("en-US", {timeZone:"America/New_York", month:"long", day:"numeric", hour:"numeric", minute:"2-digit"}) + " ET" : "Visit the schedule for the season calendar."}</span><a href="/schedule">Full schedule →</a></article><article class="records-card"><p>PROGRAM SNAPSHOT</p><div>{Object.entries(seasonRecords).map(([slug, team]) => <span><b>{team.overall}</b><a href={`/teams/${slug}`}>{team.name}</a></span>)}</div><small>Overall records · Wins–losses–ties<br />Varsity: {seasonRecords.varsity.region} in region</small></article><article class="notice-card"><p>MEET THE PROGRAM</p><h2>Three teams. One Bulldog family.</h2><span>Explore the Varsity, Junior Varsity, and Middle School rosters, with 42 roster entries and six coaches across the program.</span><a href="/teams/middle-school">Meet Middle School →</a></article></section>
  <section class="home-story" id="news"><div><p>FROM THE FIELD</p><h2>Every inning,<br/>together.</h2><span>Chamblee’s start is built on preparation, trust, and a group that refuses to give away an inning.</span><a href="/program">Meet the program →</a></div><img src="/images/HPC_IMG_2256.JPG" alt="Chamblee players walking together after a game" /></section>
  <section class="home-article section-wrap" aria-label="Latest article"><p class="article-label">SENIOR NIGHT · SEPTEMBER 28</p><h2><a href={seniorNight.href}>{seniorNight.title}</a></h2><p>{seniorNight.excerpt}</p><a class="article-read" href={seniorNight.href}>Read the article →</a></section>
  <section class="home-news section-wrap"><div class="section-heading"><p>FEATURED NEWS</p><h2>Inside Chamblee Softball</h2></div><div class="news-grid"><article><img src="/images/IMG_2089.JPG" alt="Chamblee player at the circle"/><small>VARSITY</small><h3>16–6–1 overall. 8–2 in region.</h3><a href="/teams/varsity">Meet the varsity team →</a></article><article><img src="/images/IMG_2140.JPG" alt="Chamblee hitter preparing to bat"/><small>TEAM</small><h3>Meet the leaders setting the standard</h3><a href="/teams/varsity">Meet the team →</a></article><article><img src="/images/IMG_2200.JPG" alt="Chamblee pitcher in motion"/><small>PROGRAM</small><h3>Three teams, one Bulldog identity</h3><a href="/program">Our program →</a></article></div></section>
  <section class="sponsor-band"><div><p>FEATURED COMMUNITY PARTNER</p><h2>Brookhaven Family Dentistry</h2><span>Proudly helping Chamblee athletes smile brighter.</span></div><a href="/support#sponsors">Become a sponsor →</a></section>
</main><SiteFooter /></Base>



