---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
---
<Base title="Chamblee Bulldogs Softball" bodyClass="home-page">
  <Nav dark />
  <main>
    <section class="home-hero">
      <div class="home-copy"><p class="eyebrow">Chamblee Softball · Varsity · JV · Middle School</p><h1>Bulldogs<br/><em>play here.</em></h1><p>The official home of Chamblee Softball and the Chamblee Softball Booster Club.</p><div class="actions"><a href="#schedule">View schedule</a><a class="outline" href="#live">Follow live ↗</a></div></div>
      <div class="home-logo"><img src="/images/chamblee-bulldog-logo.jpg" alt="Chamblee Bulldogs logo" /></div>
      <div class="season"><span>2026 SEASON</span><strong>7–2</strong><small>OVERALL RECORD</small></div>
    </section>
    <section class="score-band" id="schedule"><div><p class="eyebrow">Last game · Final</p><h2>Chamblee <strong>3</strong></h2><h2>Midtown <strong>2</strong></h2></div><div class="region"><span>REGION</span><strong>3–0</strong><small>1ST PLACE</small></div><a class="gold-button" href="#live">Game recap →</a></section>
    <section class="community" id="sponsors"><div><p class="eyebrow">Powered by our community</p><h2>Backing the Bulldogs.</h2><p>Local partners help provide equipment, travel support, field improvements, and opportunities for every athlete.</p></div><div class="sponsor"><span>FEATURED SPONSOR</span><strong>Brookhaven</strong><small>FAMILY DENTISTRY</small></div><div class="support" id="donate"><span>EVERY GIFT HELPS</span><strong>Support the<br/>2026 season.</strong><a class="gold-button" href="#">Donate now →</a><small>Venmo and Zelle also accepted</small></div></section>
    <a class="concept-entry" href="/ui-concepts">Explore four alternative homepage concepts →</a>
  </main>
</Base>
