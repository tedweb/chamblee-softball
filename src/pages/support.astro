---
import Base from "../layouts/Base.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro"; import PageHero from "../components/PageHero.astro";
import { featuredSponsors } from "../data/sponsors";
import siteData from "../../docs/data.json";

// Donation buttons come from "donation_links" in docs/data.json.
// Each entry needs a name and url; "description" and "cta" (button text) are optional.
interface DonationLink { name: string; url: string; description?: string; cta?: string; }
const donationLinks = ((siteData as { donation_links?: DonationLink[] }).donation_links ?? []).filter(link => link.name && link.url);
---
<Base title="Support the Bulldogs — Chamblee Softball" bodyClass="production-site"><SiteHeader /><main><PageHero eyebrow="BACK THE BULLDOGS" title="Fuel every inning." text="Your support helps fund equipment, travel, field improvements, and opportunities for every Chamblee athlete." /><section class="give-section section-wrap" id="donate"><div><p>MAKE A GIFT</p><h2>Every contribution moves the program forward.</h2><span>The Chamblee Softball Booster Club is a passionate, community-driven 501(c)(3) organization dedicated to empowering student-athletes both on and off the field. By providing essential funding for modern equipment, facility upgrades, and player development programs, the club directly ensures that the talented athletes of Chamblee High School can compete safely and at the highest level. Your tax-deductible donation is more than a financial contribution; it is a direct investment in cultivating teamwork, leadership, and lifelong confidence in young women within our community. Join us in championing the next generation of leaders—every dollar stays local and transforms their dedication into milestone achievements.</span></div><div class="give-options">{donationLinks.map(link => <a href={link.url} target="_blank" rel="noopener"><b>{link.name}</b>{link.description && <span>{link.description}</span>}<small>{link.cta ?? "Give now"} →</small></a>)}</div></section><section class="sponsor-section" id="sponsors"><div><p>SPONSORSHIP OPPORTUNITIES</p><h2>Put your business behind the Bulldogs.</h2><span>Support local student-athletes while reaching Chamblee families and fans through field signage, digital recognition, and team events.</span><a href="mailto:softball@example.org">Request the sponsor guide →</a></div>{featuredSponsors.length > 0 && <aside><p>{featuredSponsors.length > 1 ? "FEATURED SPONSORS" : "FEATURED SPONSOR"}</p>{featuredSponsors.map(sponsor => <div class="featured-sponsor">
      {sponsor.image && <img src={sponsor.image} alt={`${sponsor.name} logo`} loading="lazy" />}
      <h3>{sponsor.url ? <a href={sponsor.url} target="_blank" rel="noopener">{sponsor.name}</a> : sponsor.name}</h3>
      {sponsor.tagline && <span>{sponsor.tagline}</span>}
    </div>)}</aside>}</section><section class="gear-section section-wrap" id="gear"><div><p>FAN GEAR</p><h2>Wear the blue and gold.</h2><span>The official team store is being prepared. Shirts, hats, and spirit wear will be available here.</span></div><img src="/images/IMG_2140.JPG" alt="Chamblee player in blue and gold uniform"/></section></main><SiteFooter /></Base>

<style>
  .booster-mission { margin: 0 0 12px; font: 400 1.05rem/1.75 "DM Sans", Arial, sans-serif; }
  .featured-sponsor + .featured-sponsor { margin-top: 28px; padding-top: 28px; border-top: 1px solid #102f6533; }
  .featured-sponsor img { display: block; max-width: 100%; max-height: 80px; padding: 10px; background: #fff; border-radius: 8px; object-fit: contain; }
  .featured-sponsor h3 a { margin: 0; color: inherit; text-decoration: none; }
  .featured-sponsor h3 a:hover { text-decoration: underline; }
</style>
