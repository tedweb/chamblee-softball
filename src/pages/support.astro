---
import Base from "../layouts/Base.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro"; import PageHero from "../components/PageHero.astro";
import { featuredSponsors } from "../data/sponsors";
import siteData from "../../docs/data.json";

// Donation buttons come from "donation_links" in docs/data.json.
// Each entry needs a name and url; "description" and "cta" (button text) are optional.
interface DonationLink { name: string; url: string; description?: string; cta?: string; qr_code?: string; }
// qr_code may be a web path ("/images/…") or a project path ("chamblee-softball/public/images/…").
// Anything up to and including "public/" is dropped so it becomes a URL the browser can load.
const qrSrc = (value?: string) => {
  const path = value?.trim();
  if (!path) return undefined;
  if (/^(https?:)?\/\//.test(path)) return path;
  return "/" + path.replace(/^.*?public\//, "").replace(/^\/+/, "");
};
const donationLinks = ((siteData as { donation_links?: DonationLink[] }).donation_links ?? []).filter(link => link.name && link.url);
---
<Base title="Support the Bulldogs — Chamblee Softball" bodyClass="production-site"><SiteHeader /><main><PageHero eyebrow="BACK THE BULLDOGS" title="Fuel every inning." text="Your support helps fund equipment, travel, field improvements, and opportunities for every Chamblee athlete." /><section class="give-section section-wrap" id="donate"><div><p>MAKE A GIFT</p><h2>Every contribution moves the program forward.</h2><span>The Chamblee Softball Booster Club is a passionate, community-driven 501(c)(3) organization dedicated to empowering student-athletes both on and off the field. By providing essential funding for modern equipment, facility upgrades, and player development programs, the club directly ensures that the talented athletes of Chamblee High School can compete safely and at the highest level. Your tax-deductible donation is more than a financial contribution; it is a direct investment in cultivating teamwork, leadership, and lifelong confidence in young women within our community. Join us in championing the next generation of leaders—every dollar stays local and transforms their dedication into milestone achievements.</span></div><div class="give-options">{donationLinks.map(link => { const qr = qrSrc(link.qr_code); return <a href={link.url} target="_blank" rel="noopener" class:list={{ "has-qr": qr }}>{qr && <img class="donation-qr" src={qr} alt={`QR code for ${link.name}`} width="140" height="140" loading="lazy" />}<div class="donation-text"><b>{link.name}</b>{link.description && <span>{link.description}</span>}<small>{link.cta ?? "Give now"} →</small></div></a>; })}</div></section><section class="sponsor-section" id="sponsors"><div><p>SPONSORSHIP OPPORTUNITIES</p><h2>Put your business behind the Bulldogs.</h2><span>Support local student-athletes while reaching Chamblee families and fans through field signage, digital recognition, and team events.</span><a href="mailto:softball@example.org">Request the sponsor guide →</a></div>{featuredSponsors.length > 0 && <aside><p>{featuredSponsors.length > 1 ? "FEATURED SPONSORS" : "FEATURED SPONSOR"}</p>{featuredSponsors.map(sponsor => <article class="featured-sponsor">
      {sponsor.image && <img src={sponsor.image} alt={`${sponsor.name} logo`} loading="lazy" />}
      <h3>{sponsor.url ? <a href={sponsor.url} target="_blank" rel="noopener">{sponsor.name}</a> : sponsor.name}</h3>
      {sponsor.tagline && <span>{sponsor.tagline}</span>}
    </article>)}</aside>}</section><section class="gear-section section-wrap" id="gear"><div><p>FAN GEAR</p><h2>Wear the blue and gold.</h2><span>The official team store is being prepared. Shirts, hats, and spirit wear will be available here.</span></div><img class="gear-image" src="/images/store/gear.png" alt="Chamblee Softball fan gear" width="416" height="529" loading="lazy" /></section></main><SiteFooter /></Base>

<style>
  /* Stack the donation options under the "Make a gift" text on every screen size. */
  .give-section { grid-template-columns: 1fr; gap: 32px; }
  .give-section .give-options { max-width: 640px; }
  /* Same for the sponsorship section: sponsor list goes under the "Sponsorship opportunities" text. */
  .sponsor-section { grid-template-columns: 1fr; gap: 32px; }
  .sponsor-section aside { align-self: start; width: 100%; padding: 0; background: transparent; color: inherit; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .sponsor-section aside > p { grid-column: 1 / -1; margin: 0; }
  .featured-sponsor { min-width: 0; padding: clamp(24px, 4vw, 36px); border-radius: 16px; background: var(--gold); color: var(--navy); }
  .featured-sponsor h3 { margin: 24px 0 16px; overflow-wrap: anywhere; }
  .featured-sponsor > span { font: 400 1rem/1.65 "DM Sans", Arial, sans-serif; }
  /* Line every section's content up with the 1180px .section-wrap column used by the gift and gear sections.
     Full-width backgrounds (hero, sponsorship) stay edge to edge; only their content is inset. */
  .sponsor-section { padding: 90px max(24px, calc((100% - 1132px) / 2)); }
  :global(.page-hero.no-image) > :global(div) { padding-inline: max(24px, calc((100% - 1132px) / 2)); }
  @media (max-width: 640px) { .sponsor-section { padding-block: 65px; } }
  /* Fan gear product image: show the whole image at its natural shape instead of cropping it like a photo. */
  .gear-section .gear-image { width: auto; max-width: 100%; height: auto; max-height: 529px; object-fit: contain; justify-self: center; }
  .give-options .donation-text { display: grid; gap: 4px; }
  .give-options a.has-qr { grid-template-columns: auto minmax(0, 1fr); align-items: center; justify-content: start; gap: 12px; }
  .donation-qr { width: 140px; height: 140px; padding: 6px; background: #fff; border: 1px solid var(--line); border-radius: 8px; }
  @media (max-width: 400px) { .give-options a.has-qr { gap: 10px; } .donation-qr { width: 104px; height: 104px; } }
  .booster-mission { margin: 0 0 12px; font: 400 1.05rem/1.75 "DM Sans", Arial, sans-serif; }

  .featured-sponsor img { display: block; max-width: 100%; max-height: 80px; padding: 10px; background: #fff; border-radius: 8px; object-fit: contain; }
  .featured-sponsor h3 a { margin: 0; color: inherit; text-decoration: none; }
  .featured-sponsor h3 a:hover { text-decoration: underline; }
</style>
