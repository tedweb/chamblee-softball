---
import Base from "../layouts/Base.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro"; import PageHero from "../components/PageHero.astro";
const faqs=["How do families receive schedule changes?","What equipment does a player need?","Where are home games played?","How can I volunteer with the booster club?"];
---
<Base title="Resources — Chamblee Softball" bodyClass="production-site"><SiteHeader /><main><PageHero eyebrow="PLAYER & FAMILY HUB" title="Ready for the season." text="Forms, dates, tryout details, and answers for Chamblee Softball families." /><section class="resource-grid section-wrap"><article><span>01</span><h2>Forms & documents</h2><p>Physicals, participation forms, handbooks, and program documents will be organized here.</p><a href="#">Documents coming soon</a></article><article><span>02</span><h2>Tryout information</h2><p>Eligibility, required equipment, dates, and check-in instructions for each team level.</p><a href="#">2026 details coming soon</a></article><article><span>03</span><h2>Camps & clinics</h2><p>Off-season development opportunities for current and future Bulldogs.</p><a href="#">View upcoming events</a></article><article><span>04</span><h2>Team communication</h2><p>Private team documents and announcements will move here when secure access is ready.</p><a href="https://classroom.google.com/">Open Google Classroom ↗</a></article></section><section class="faq-section section-wrap"><div class="section-heading"><p>FREQUENTLY ASKED QUESTIONS</p><h2>Good to know</h2></div><div>{faqs.map((q,i)=><details><summary>{q}</summary><p>{i===0?"Coaches use GameChanger and the team communication hub for time-sensitive updates. Confirm the final communication process with your coach.":"Final program guidance will be added here before launch. Contact a coach or booster club administrator for current information."}</p></details>)}</div></section></main><SiteFooter /></Base>
