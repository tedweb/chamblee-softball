---
const path = Astro.url.pathname;
const nav = [["/teams/varsity","Meet the Bulldogs"],["/schedule","Schedule"],["/gallery","Gallery"],["/program","Program"],["/support","Support"],["/resources","Resources"]];
---
<header class="main-header"><a class="main-brand" href="/"><img src="/images/chamblee-bulldog-logo.jpg" alt="Chamblee Bulldogs" /><span>CHAMBLEE <b>SOFTBALL</b></span></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([href,label]) => <a class:list={{ active: path.startsWith(href.split('/').slice(0,2).join('/')) }} href={href}>{label}</a>)}</nav><div class="header-actions"><a class="live-link" href="https://gc.com/" target="_blank" rel="noreferrer">GameChanger ↗</a><a class="give-link" href="/support#donate">Donate</a></div><details class="mobile-menu"><summary>Menu</summary><div>{nav.map(([href,label]) => <a href={href}>{label}</a>)}<a href="https://gc.com/">GameChanger ↗</a></div></details></header>
