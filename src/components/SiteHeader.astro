---
const path = Astro.url.pathname;
const nav = [["/teams/varsity","Meet the Bulldogs"],["/schedule","Schedule"],["/articles","Articles"],["/gallery","Gallery"],["/support","Support"],["/resources","Resources"],["/program","About Us"]];
---
<header class="main-header"><a class="main-brand" href="/"><img src="/images/chamblee-bulldog-logo.jpg" alt="Chamblee Bulldogs" /><span>CHAMBLEE <b>SOFTBALL</b></span></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([href,label]) => <a class:list={{ active: path.startsWith(href.split('/').slice(0,2).join('/')) }} href={href}>{label}</a>)}</nav><div class="header-actions"><a class="give-link" href="/support">Donate</a></div><details class="mobile-menu"><summary>Menu</summary><div>{nav.filter(([href]) => href !== "/support").map(([href,label]) => <a href={href}>{label}</a>)}</div></details></header>
